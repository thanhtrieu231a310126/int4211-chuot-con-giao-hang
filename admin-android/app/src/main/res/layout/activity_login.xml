<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình Đăng nhập Chuột Con-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <!-- Khoảng cách phía trên -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!-- Logo -->
        <ImageView
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:src="@drawable/logo_chuot_con"
            android:scaleType="fitCenter"
            android:contentDescription="Logo Chuột Con - Điều Phối" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Hệ thống quản lý &amp; phân công giao hàng"
            android:textColor="#71717A"
            android:textSize="13sp" />

        <!-- Khoảng cách giữa logo và form nhập -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- 1. Ô nhập Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsername"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:textColorHint="#71717A"
            app:hintTextColor="#F97316"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#E4DFD7"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1.5dp"
            app:boxBackgroundColor="#FFFDF9"
            app:startIconDrawable="@drawable/ic_mail_24"
            app:startIconTint="#71717A"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:textColor="#18181B"
                android:textSize="14sp"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2. Ô nhập Mật khẩu  -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Mật khẩu"
            android:textColorHint="#71717A"
            app:hintTextColor="#F97316"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#E4DFD7"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1.5dp"
            app:boxBackgroundColor="#FFFDF9"
            app:startIconDrawable="@drawable/ic_lock_24"
            app:startIconTint="#71717A"
            app:endIconMode="password_toggle"
            app:endIconTint="#71717A"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:textColor="#18181B"
                android:textSize="14sp"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 3. Nút Đăng nhập -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="ĐĂNG NHẬP"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F97316"
            app:cornerRadius="14dp"
            app:rippleColor="#80FFFFFF"
            android:elevation="0dp" />

    </LinearLayout>
</ScrollView>