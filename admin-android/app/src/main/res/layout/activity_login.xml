<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình Đăng nhập -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <!-- Khoảng cách phía trên -->
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp" />

        <!-- Icon xe máy giao hàng màu cam -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛵"
            android:textSize="56sp" />

        <!-- Tiêu đề App dành cho Điều Phối -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Chuột Con - Điều Phối"
            android:textColor="#18181B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hệ thống quản lý &amp; phân công giao hàng"
            android:textColor="#71717A"
            android:textSize="13sp" />

        <!-- Khoảng cách giữa logo và form -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- Ô nhập Email-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsername"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:textColorHint="#71717A"
            app:hintTextColor="#F97316"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#F97316"
            app:boxBackgroundColor="#FFFFFF"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="#71717A"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:textColor="#18181B"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ô nhập Mật khẩu -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Mật khẩu"
            android:textColorHint="#71717A"
            app:hintTextColor="#F97316"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#F97316"
            app:boxBackgroundColor="#FFFFFF"
            app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
            app:startIconTint="#71717A"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="#71717A"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:textColor="#18181B"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="ĐĂNG NHẬP"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F97316"
            app:cornerRadius="26dp" />

    </LinearLayout>
</ScrollView>