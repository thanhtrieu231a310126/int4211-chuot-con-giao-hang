<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình Bàn điều phối -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF7F2">

    <!-- Header tiêu đề tối giản -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bàn Điều Phối"
            android:textColor="#18181B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSoLuongDon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Đơn chưa gán: 0"
            android:textColor="#71717A"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Hộp tìm kiếm lọc theo Phường/Xã bo tròn -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#E4DFD7"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="#FFFDF9">

        <EditText
            android:id="@+id/edtLocPhuong"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@null"
            android:paddingHorizontal="16dp"
            android:hint="🔍 Lọc theo Phường/Xã..."
            android:textColor="#18181B"
            android:textColorHint="#A1A1AA"
            android:textSize="14sp"
            android:inputType="text" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Vòng xoay tiến trình khi đang kết nối API Render -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="24dp"
        android:indeterminateTint="#F97316"
        android:visibility="gone" />

    <!-- Danh sách đơn hàng bằng RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDonHang"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- Dòng thông báo khi danh sách rỗng -->
    <TextView
        android:id="@+id/tvDanhSachRong"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Không có đơn hàng nào phù hợp"
        android:textColor="#A1A1AA"
        android:textSize="15sp"
        android:visibility="gone" />

</LinearLayout>