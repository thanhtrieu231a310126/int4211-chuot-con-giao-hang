@startuml
' Bố cục của SVG được chỉnh tay trong thư mục diagrams.
left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam monochrome true
skinparam nodesep 18
skinparam ranksep 42
skinparam linetype polyline
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam ArrowColor #222222
skinparam ArrowThickness 1.3
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #222222
  FontColor #000000
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #222222
  FontColor #000000
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #222222
  FontColor #000000
}

actor "Người điều phối" as Dispatcher

rectangle "HỆ THỐNG ĐIỀU PHỐI GIAO HÀNG" {
  usecase "UC-01\nĐăng nhập" as UC01
  usecase "UC-02\nTạo, sửa và hủy đơn" as UC02
  usecase "UC-03\nXem và lọc đơn chưa gán" as UC03
  usecase "UC-04\nQuản lý tài khoản shipper" as UC04
  usecase "UC-05\nXem tải hiện tại của shipper" as UC05
  usecase "UC-06\nGán đơn cho shipper" as UC06
  usecase "UC-07\nTheo dõi đơn trong ngày" as UC07
  usecase "UC-13\nXử lý đơn giao thất bại" as UC13
  usecase "UC-15\nĐối soát COD" as UC15
  usecase "UC-16\nXem báo cáo và biểu đồ" as UC16

}

Dispatcher -right- UC01
Dispatcher -right- UC02
Dispatcher -right- UC03
Dispatcher -right- UC04
Dispatcher -right- UC05
Dispatcher -right- UC06
Dispatcher -right- UC07
Dispatcher -right- UC13
Dispatcher -right- UC15
Dispatcher -right- UC16

UC06 ..> UC03 : <<include>>\n[chọn đơn chưa gán]
UC06 ..> UC05 : <<include>>\n[kiểm tra khả năng nhận]

@enduml
