@startuml
' Bố cục của SVG được chỉnh tay trong thư mục diagrams.
left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam monochrome true
skinparam nodesep 18
skinparam ranksep 42
skinparam linetype polyline
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam ArrowColor #222222
skinparam ArrowThickness 1.3
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #222222
  FontColor #000000
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #222222
  FontColor #000000
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #222222
  FontColor #000000
}

actor "Shipper" as Shipper
actor "Google Maps" as Maps

rectangle "HỆ THỐNG ĐIỀU PHỐI GIAO HÀNG" {
  usecase "UC-01\nĐăng nhập" as UC01
  usecase "UC-08\nXem đơn được giao" as UC08
  usecase "UC-09\nXem chi tiết đơn và mở Google Maps" as UC09
  usecase "UC-10\nCập nhật đã lấy hàng và đang giao" as UC10
  usecase "UC-11\nXác nhận giao thành công" as UC11
  usecase "UC-12\nBáo giao thất bại" as UC12
  usecase "UC-14\nXem COD đang giữ" as UC14
  usecase "UC-17\nCung cấp bằng chứng giao hàng" as UC17

}

Shipper -right- UC01
Shipper -right- UC08
Shipper -right- UC09
Shipper -right- UC10
Shipper -right- UC11
Shipper -right- UC12
Shipper -right- UC14
Maps -right- UC09

UC11 ..> UC17 : <<include>>
UC12 ..> UC17 : <<include>>

@enduml
